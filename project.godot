;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodotGUI"
run/main_scene="res://src/ui/MainMenu/titleScreen/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Global="*uid://cyoi03ygio31w"

